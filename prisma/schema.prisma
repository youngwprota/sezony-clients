generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Настройки салона. В базе одна запись с id = 1.
model Salon {
  id                Int    @id @default(1)
  name              String
  description       String @default("")
  address           String @default("")
  phone             String @default("")
  timezone          String @default("Europe/Minsk")
  currency          String @default("BYN")
  phoneCountryCode  String @default("+375")
  /// Шаг сетки свободного времени для онлайн-записи, минуты
  slotStepMinutes   Int    @default(30)
  /// Минимум минут от «сейчас» до начала записи
  minLeadMinutes    Int    @default(60)
  /// На сколько дней вперёд открыта онлайн-запись
  bookingDaysAhead  Int    @default(60)
  /// Напоминание клиенту за сутки
  remindDayBefore   Boolean @default(true)
  /// Напоминание клиенту за N часов (0 — не отправлять)
  remindHoursBefore Int     @default(2)
  /// Автопоздравление с днём рождения (только клиентам с согласием на рассылки)
  birthdayGreetingEnabled Boolean @default(false)
  birthdayGreetingText    String  @default("{имя}, с днём рождения! 🎉 Дарим вам скидку 10% на любую услугу в течение недели. Ваши «Sезоны»")
}

model ServiceCategory {
  id        Int       @id @default(autoincrement())
  title     String
  sortOrder Int       @default(0)
  services  Service[]
}

model Service {
  id             Int             @id @default(autoincrement())
  categoryId     Int
  category       ServiceCategory @relation(fields: [categoryId], references: [id])
  title          String
  description    String          @default("")
  priceMin       Decimal         @db.Decimal(10, 2)
  priceMax       Decimal         @db.Decimal(10, 2)
  durationMin    Int
  sortOrder      Int             @default(0)
  active         Boolean         @default(true)
  /// Показывать в онлайн-записи
  online         Boolean         @default(true)
  staff          StaffService[]
  appointmentItems AppointmentService[]

  @@index([categoryId])
}

model Staff {
  id             Int            @id @default(autoincrement())
  name           String
  specialization String         @default("")
  bio            String         @default("")
  avatarUrl      String?
  sortOrder      Int            @default(0)
  active         Boolean        @default(true)
  /// Можно ли записаться онлайн
  bookable       Boolean        @default(true)
  telegramChatId String?
  viberUserId    String?
  services       StaffService[]
  shifts         StaffShift[]
  appointments   Appointment[]
  user           User?
}

/// Какие услуги делает мастер; цена и длительность могут отличаться от базовых.
model StaffService {
  staffId     Int
  serviceId   Int
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  priceMin    Decimal? @db.Decimal(10, 2)
  priceMax    Decimal? @db.Decimal(10, 2)
  durationMin Int?

  @@id([staffId, serviceId])
}

/// Рабочая смена мастера в конкретный день (время — местное время салона).
model StaffShift {
  id       Int    @id @default(autoincrement())
  staffId  Int
  staff    Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  /// YYYY-MM-DD
  date     String
  /// HH:mm
  start    String
  /// HH:mm
  end      String

  @@index([staffId, date])
}

model Client {
  id           Int           @id @default(autoincrement())
  name         String
  phone        String        @unique
  email        String?
  comment      String        @default("")
  /// YYYY-MM-DD
  birthday     String?
  marketingConsent Boolean   @default(false)
  telegramChatId String?
  viberUserId  String?
  /// Личная скидка, %. Если задана — важнее скидки уровня лояльности
  personalDiscount Int?
  createdAt    DateTime      @default(now())
  appointments Appointment[]
  campaignRecipients CampaignRecipient[]
  autoMessages AutoMessageLog[]

  @@index([name])
}

/// Уровень программы лояльности. Клиент получает уровень по числу визитов («Пришёл»).
model LoyaltyLevel {
  id              Int    @id @default(autoincrement())
  name            String
  minVisits       Int    @unique
  discountPercent Int    @default(0)
  /// Что ещё даёт уровень (видят сотрудники и клиент в боте)
  perks           String @default("")
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  CANCELLED
}

/// Рассылка по сегменту клиентов в Telegram / Viber.
model Campaign {
  id         Int                 @id @default(autoincrement())
  title      String
  text       String
  /// Фильтр аудитории, см. src/lib/segments.ts
  segment    Json
  /// Кнопка «Записаться» со ссылкой на сайт
  bookButton Boolean             @default(true)
  status     CampaignStatus      @default(DRAFT)
  createdAt  DateTime            @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  recipients CampaignRecipient[]
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

model CampaignRecipient {
  id         Int            @id @default(autoincrement())
  campaignId Int
  campaign   Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clientId   Int
  client     Client         @relation(fields: [clientId], references: [id])
  /// telegram | viber
  channel    String
  status     DeliveryStatus @default(PENDING)
  error      String?
  sentAt     DateTime?

  @@unique([campaignId, clientId, channel])
  @@index([status])
}

/// Журнал автоматических сообщений, чтобы не отправить одно и то же дважды (например, birthday:2026).
model AutoMessageLog {
  id       Int      @id @default(autoincrement())
  clientId Int
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  key      String
  sentAt   DateTime @default(now())

  @@unique([clientId, key])
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  ARRIVED
  NO_SHOW
  CANCELLED
}

enum AppointmentSource {
  ONLINE
  ADMIN
}

model Appointment {
  id        Int                  @id @default(autoincrement())
  staffId   Int
  staff     Staff                @relation(fields: [staffId], references: [id])
  clientId  Int
  client    Client               @relation(fields: [clientId], references: [id])
  startsAt  DateTime             @db.Timestamptz(3)
  endsAt    DateTime             @db.Timestamptz(3)
  status    AppointmentStatus    @default(BOOKED)
  source    AppointmentSource
  comment   String               @default("")
  /// Пометка, что мастер уже видел запись в приложении
  seenByStaff Boolean            @default(false)
  /// Когда клиенту отправлены напоминания (чтобы не слать повторно)
  remindDaySentAt   DateTime?    @db.Timestamptz(3)
  remindHoursSentAt DateTime?    @db.Timestamptz(3)
  createdAt DateTime             @default(now())
  items     AppointmentService[]

  @@index([staffId, startsAt])
  @@index([clientId])
}

model AppointmentService {
  id            Int         @id @default(autoincrement())
  appointmentId Int
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId     Int
  service       Service     @relation(fields: [serviceId], references: [id])
  /// Снимок названия и цены на момент записи
  title         String
  priceMin      Decimal     @db.Decimal(10, 2)
  priceMax      Decimal     @db.Decimal(10, 2)
  durationMin   Int
  sortOrder     Int         @default(0)
}

enum Role {
  OWNER
  ADMIN
  MASTER
}

model User {
  id           Int                @id @default(autoincrement())
  login        String             @unique
  passwordHash String
  /// Увеличивается при смене пароля — старые сеансы перестают действовать
  tokenVersion Int                @default(0)
  role         Role
  staffId      Int?               @unique
  staff        Staff?             @relation(fields: [staffId], references: [id])
  pushSubscriptions PushSubscription[]
  createdAt    DateTime           @default(now())
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
